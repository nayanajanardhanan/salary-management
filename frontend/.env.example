# Base URL of the PayScope backend API (no trailing slash, no /api/v1 suffix).
#
# Resolved by Vite at BUILD time, not at runtime (see src/api/client.ts) —
# changing it requires rebuilding, whether via `npm run build` or the
# Docker image (`docker build --build-arg VITE_API_BASE_URL=...`, see
# docs/deployment.md). `npm run dev` falls back to the value below on its
# own if this is unset; `npm run build` (and the Docker build) do not — they
# fail loudly instead of silently defaulting, so a real build is never
# accidentally shipped pointed at localhost.
VITE_API_BASE_URL=http://localhost:8000
