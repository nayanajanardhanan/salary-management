# Environment variables for `docker compose up` (docker-compose.yml), read
# from a `.env` file in this directory by Docker Compose automatically.
#
# This is separate from backend/.env.example and frontend/.env.example,
# which configure the backend/frontend when run directly (not in
# containers) — see backend/README.md and frontend/README.md for those.
#
# Copy this file to `.env` and set real values before running
# `docker compose up`:
#
#   copy .env.example .env        # Windows
#   cp .env.example .env            # macOS/Linux
#
# Never commit the resulting `.env` file (it is gitignored) or reuse these
# placeholder values anywhere real.

# --- PostgreSQL (the `db` service) ---
POSTGRES_DB=payscope
POSTGRES_USER=payscope
# Required — docker-compose.yml refuses to start the db/backend services
# without this set. Use a long, random value; never reuse this example.
POSTGRES_PASSWORD=changeme-placeholder-postgres-password

# --- Backend (the `backend` service) ---
PAYSCOPE_ENVIRONMENT=production
PAYSCOPE_DEBUG=false
# Required — signs/verifies JWT access tokens (see backend/README.md
# #authentication). Use a long, random value; never reuse this example.
PAYSCOPE_JWT_SECRET_KEY=changeme-placeholder-jwt-secret
PAYSCOPE_JWT_ALGORITHM=HS256
PAYSCOPE_JWT_EXPIRE_MINUTES=60

# Optional — creates one development HR user when the seed script is run
# (see docs/deployment.md). Leave PAYSCOPE_HR_SEED_PASSWORD unset/blank to
# skip HR-user seeding entirely.
PAYSCOPE_HR_SEED_USERNAME=hr.admin
PAYSCOPE_HR_SEED_EMAIL=hr.admin@payscope.local
PAYSCOPE_HR_SEED_PASSWORD=

# Comma-separated origins allowed to call the API from a browser. The
# default matches the frontend service's published port below (for local
# `docker compose up` use only) — set explicitly to your real frontend
# origin for anything beyond local use.
PAYSCOPE_CORS_ORIGINS=http://localhost:5173

# One of DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive).
PAYSCOPE_LOG_LEVEL=INFO

# --- Frontend (the `frontend` service) ---
# Baked into the static frontend bundle at image-build time (Vite
# convention — see frontend/src/api/client.ts). The default below assumes
# the backend's port is published to this machine as configured (BACKEND_PORT
# below), so a browser on this machine can reach it at localhost. Set this
# explicitly to the backend's real, reachable URL for any other target —
# never leave it unset for a non-local build.
VITE_API_BASE_URL=http://localhost:8000

# --- Published host ports (optional overrides) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
