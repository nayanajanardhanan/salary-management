PAYSCOPE_APP_NAME=PayScope API
PAYSCOPE_ENVIRONMENT=development
PAYSCOPE_DEBUG=true

# SQLite is used by default for local development/tests (no setup required).
# Point this at PostgreSQL for production-like environments, e.g.:
# PAYSCOPE_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/payscope
PAYSCOPE_DATABASE_URL=sqlite:///./payscope.db
