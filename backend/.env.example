PAYSCOPE_APP_NAME=PayScope API
PAYSCOPE_ENVIRONMENT=development
PAYSCOPE_DEBUG=true

# SQLite is used by default for local development/tests (no setup required).
# Point this at PostgreSQL for production-like environments, e.g.:
# PAYSCOPE_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/payscope
PAYSCOPE_DATABASE_URL=sqlite:///./payscope.db

# Secret used to sign/verify the access tokens issued by POST
# /api/v1/auth/login. Required to access any /api/v1/* endpoint (employee,
# salary, and analytics data): callers must send
# `Authorization: Bearer <access token>`, and requests with a missing,
# invalid, or expired token are rejected with 401. Set this to a long,
# random value per environment — never commit a real secret. Without it, no
# one can log in and no token can be validated (fails closed).
PAYSCOPE_JWT_SECRET_KEY=changeme-placeholder-jwt-secret
# Signing algorithm for access tokens.
PAYSCOPE_JWT_ALGORITHM=HS256
# How long an access token stays valid after login, in minutes.
PAYSCOPE_JWT_EXPIRE_MINUTES=60

# Development HR login, created by `python -m app.scripts.seed` (idempotent —
# running the seed command again never creates a duplicate). Sign in at
# POST /api/v1/auth/login with this username (or email) and password. Change
# PAYSCOPE_HR_SEED_PASSWORD to your own value locally — never commit a real
# password. Leave PAYSCOPE_HR_SEED_PASSWORD unset to skip HR-user seeding.
PAYSCOPE_HR_SEED_USERNAME=hr.admin
PAYSCOPE_HR_SEED_EMAIL=hr.admin@payscope.local
PAYSCOPE_HR_SEED_PASSWORD=changeme-placeholder-password

# Comma-separated list of origins allowed to call this API from a browser
# (CORS). Defaults to the Vite dev server's origin (http://localhost:5173)
# if unset; set explicitly to the deployed frontend's origin in production.
# PAYSCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Root logger level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
# (case-insensitive). An unrecognized value fails at startup.
PAYSCOPE_LOG_LEVEL=INFO
