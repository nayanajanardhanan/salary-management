PAYSCOPE_APP_NAME=PayScope API
PAYSCOPE_ENVIRONMENT=development
PAYSCOPE_DEBUG=true

# SQLite is used by default for local development/tests (no setup required).
# Point this at PostgreSQL for production-like environments, e.g.:
# PAYSCOPE_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/payscope
PAYSCOPE_DATABASE_URL=sqlite:///./payscope.db

# Required to access any /api/v1/* endpoint (employee, salary, and analytics
# data): callers must send `Authorization: Bearer <this value>`. Requests
# without a matching token are rejected with 401. Set this to a long, random
# value per environment — never commit a real token.
PAYSCOPE_API_TOKEN=changeme-placeholder-token

# Comma-separated list of origins allowed to call this API from a browser
# (CORS). Defaults to the Vite dev server's origin (http://localhost:5173)
# if unset; set explicitly to the deployed frontend's origin in production.
# PAYSCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
